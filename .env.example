# ========================================================
# VIJAYAHUB PRODUCTION ENVIRONMENT VARIABLES
# ========================================================

# --- 1. SUPABASE CLOUD DATABASE ---
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- 2. FAST2SMS GATEWAY (INDIAN SMS OTP DELIVERY) ---
# Found in: Fast2SMS Dashboard -> Dev API (https://www.fast2sms.com/dashboard/dev-api)
VITE_FAST2SMS_API_KEY=your_fast2sms_api_key_here

# --- 3. RAZORPAY PAYMENT GATEWAY ---
# Found in: Razorpay Dashboard -> Settings -> API Keys
VITE_RAZORPAY_KEY_ID=rzp_live_your_actual_key_here
