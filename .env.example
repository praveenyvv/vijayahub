# ========================================================
# VIJAYAHUB PRODUCTION ENVIRONMENT VARIABLES
# ========================================================

# --- 1. SUPABASE CLOUD DATABASE ---
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- 2. FIREBASE PHONE AUTHENTICATION (REAL SMS OTP) ---
# Found in: Firebase Console -> Project Settings -> General -> "Your apps" (Web app SDK config)
VITE_FIREBASE_API_KEY=AIzaSyYourActualFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --- 3. RAZORPAY PAYMENT GATEWAY ---
# Found in: Razorpay Dashboard -> Settings -> API Keys
VITE_RAZORPAY_KEY_ID=rzp_live_your_actual_key_here
